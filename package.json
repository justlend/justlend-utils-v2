{
  "name": "justlend-v2-utils",
  "version": "1.0.0",
  "description": "Utility library for interacting with JustLend V2 protocol",
  "type": "module",
  "main": "./dist/justlend-v2-utils.umd.cjs",
  "module": "./dist/justlend-v2-utils.js",
  "exports": {
    ".": {
      "import": "./dist/justlend-v2-utils.js",
      "require": "./dist/justlend-v2-utils.umd.cjs"
    }
  },

  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "license": "Apache-2.0",
  
  "dependencies": {
    "bignumber.js": "^9.1.1",
    "tronweb": "6.0.4"
  },

  "pnpm": {
    "overrides": {
      "axios": ">=1.16.0",
      "ws": ">=8.21.0",
      "validator": ">=13.15.22",
      "form-data": ">=4.0.6",
      "follow-redirects": ">=1.16.0"
    }
  },

  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@tronweb3/tronwallet-abstract-adapter": "^1.1.10",
    "@tronweb3/tronwallet-adapter-react-hooks": "^1.1.11",
    "@tronweb3/tronwallet-adapter-react-ui": "^1.1.12",
    "@tronweb3/tronwallet-adapters": "^1.2.20",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "antd": "^6.2.3",
    "buffer": "6.0.3",
    "jsdom": "^27.0.1",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^1.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justlend/justlend-v2-utils.git"
  },
  "bugs": {
    "url": "https://github.com/justlend/justlend-v2-utils/issues"
  },
  "homepage": "https://github.com/justlend/justlend-v2-utils#readme"
}